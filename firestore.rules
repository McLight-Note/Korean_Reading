rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Everything a learner stores lives under users/{their own uid}. Nobody else can read or write it.
    match /users/{uid}/passages/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['title', 'text', 'createdAt', 'updatedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 20000
        && (!('title' in request.resource.data) || request.resource.data.title == null
            || (request.resource.data.title is string && request.resource.data.title.size() <= 200));
    }

    match /users/{uid}/saved/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['kind', 'ref_id', 'text', 'sentence', 'item', 't'])
        && request.resource.data.kind in ['vocab', 'grammar', 'word'];
    }

    // Study progress: split into small documents by the app (meta, cards_N, log_YYYY-MM, ex_YYYY-MM).
    match /users/{uid}/study/{id} {
      allow read, write: if owner(uid);
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
