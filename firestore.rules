rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The stories: everyone may read them, nobody may change them from the website.
    // (They are written by scripts/publish_stories.py with the service-account key, which bypasses these rules.)
    match /stories/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Each person's read list: users/{their own uid}/read/{storyId} = { t: <timestamp in ms> }. Nobody else can see it.
    match /users/{uid}/read/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['t'])
        && request.resource.data.t is number;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
